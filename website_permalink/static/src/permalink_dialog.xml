<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="website_permalink.PermalinkDialog">
        <Dialog size="'md'" title="this.title">
            <p class="fw-bold mb-1">Website Permalink kept this page's URL.</p>
            <p><code t-out="this.props.url"/></p>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="permalink_choice" id="permalink_keep" value="keep" t-model.proxy="this.state.choice"/>
                <label class="form-check-label" for="permalink_keep">Keep URL</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="permalink_choice" id="permalink_change" value="change" t-model.proxy="this.state.choice"/>
                <label class="form-check-label" for="permalink_change">Change URL to match the new name</label>
            </div>
            <div class="form-check ms-4" t-att-class="{'opacity-50': this.state.choice !== 'change'}">
                <input class="form-check-input" type="checkbox" id="permalink_redirect" t-model.proxy="this.state.redirect" t-att-disabled="this.state.choice !== 'change'"/>
                <label class="form-check-label" for="permalink_redirect">Redirect the old URL (301)</label>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="() => this.save()">Save</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
